                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "key": "id",
                  "value": "<string>"
                }
              ]
            },
            "header": [],
            "method": "DELETE",
            "auth": null
          },
          "response": [],
          "event": [],
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          }
        }
      ],
