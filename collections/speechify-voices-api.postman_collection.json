        {
          "id": "de95bb83-11e6-4a57-8c73-79577fdf0c01",
          "name": "Create a voice clone",
          "request": {
            "name": "Create a voice clone",
            "description": {
              "content": "Creates an instant personal voice clone from a 10-30 second audio sample. Requires explicit consent identifying the person who owns the voice. Submitted as multipart/form-data.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "voices"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "name",
                  "value": "<string>",
                  "type": "text",
                  "description": "(Required) Display name for the cloned voice."
                },
                {
                  "key": "sample",
                  "type": "file",
                  "description": "(Required) A 10-30 second audio sample of the voice to clone."
                },
                {
                  "key": "consent",
                  "value": "<string>",
                  "type": "text",
                  "description": "(Required) JSON string containing the fullName and email of the person who owns the voice, confirming the voice belongs to you or someone you represent."
                },
                {
                  "key": "gender",
                  "value": "<string>",
                  "type": "text",
                  "description": " (This can only be one of male,female,notSpecified)"
                },
                {
                  "key": "locale",
                  "value": "<string>",
                  "type": "text",
                  "description": "Primary locale of the voice, e.g. en-US."
                }
              ]
            }
          },
          "response": [
            {
              "id": "b888a83a-172f-4fb0-a0d0-26cb6fb396a6",
              "name": "The created personal voice.",
              "originalRequest": {
                "url": {
                  "path": [
                    "v1",
                    "voices"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": []
                },
