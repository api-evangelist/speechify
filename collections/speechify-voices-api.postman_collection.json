                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "formdata",
                  "formdata": [
                    {
                      "description": {
                        "content": "(Required) Display name for the cloned voice.",
                        "type": "text/plain"
                      },
                      "key": "name",
                      "value": "<string>",
                      "type": "text"
                    },
                    {
                      "description": {
                        "content": "(Required) A 10-30 second audio sample of the voice to clone.",
                        "type": "text/plain"
                      },
                      "key": "sample",
                      "value": "<binary>",
                      "type": "text"
                    },
                    {
                      "description": {
                        "content": "(Required) JSON string containing the fullName and email of the person who owns the voice, confirming the voice belongs to you or someone you represent.",
                        "type": "text/plain"
                      },
                      "key": "consent",
                      "value": "{\"fullName\":\"Jane Doe\",\"email\":\"jane@example.com\"}",
                      "type": "text"
                    },
                    {
                      "description": {
                        "content": " (This can only be one of male,female,notSpecified)",
                        "type": "text/plain"
                      },
                      "key": "gender",
                      "value": "<string>",
                      "type": "text"
                    },
                    {
                      "description": {
                        "content": "Primary locale of the voice, e.g. en-US.",
                        "type": "text/plain"
                      },
                      "key": "locale",
                      "value": "<string>",
                      "type": "text"
                    }
                  ]
                }
              },
              "status": "OK",
