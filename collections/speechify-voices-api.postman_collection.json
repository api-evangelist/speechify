              ],
              "body": "{\n  \"id\": \"string\",\n  \"display_name\": \"string\",\n  \"type\": \"shared\",\n  \"gender\": \"notSpecified\",\n  \"locale\": \"string\",\n  \"tags\": [\n    \"string\",\n    \"string\"\n  ],\n  \"models\": [\n    \"string\",\n    \"string\"\n  ]\n}",
